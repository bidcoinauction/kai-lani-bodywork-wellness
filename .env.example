# Kai Lani Square Appointments — environment variables.
# Names only. Never commit real values or .env files.

# Server-only. Square Access Token:
#   - sandbox:    Square Developer Console -> Kai Lani Booking -> Sandbox -> Credentials
#   - production: Production access token (long-lived, least-privilege)
SQUARE_ACCESS_TOKEN=

# EXACTLY "sandbox" or "production". Nothing else is accepted; missing,
# malformed, or mixed-case values fail closed everywhere (Square client
# constructor, every booking-request handler, email delivery). Production is
# never defaulted to. Must match BOOKING_APPROVAL_MODE.
SQUARE_ENVIRONMENT=

# Location and team member (Chelsea) IDs. Use the IDs belonging to the
# environment chosen above.
SQUARE_LOCATION_ID=
SQUARE_TEAM_MEMBER_ID=

# Catalog service variation IDs (one per bookable service) for the environment.
SQUARE_SERVICE_CUSTOMIZED_60_ID=
SQUARE_SERVICE_DEEP_TISSUE_60_ID=
SQUARE_SERVICE_PRENATAL_60_ID=
SQUARE_SERVICE_CUSTOMIZED_90_ID=
SQUARE_SERVICE_DEEP_TISSUE_90_ID=

# Webhook signature key and notification URL from the Square Developer Console.
# Subscribe to booking.created and booking.updated only; Square does not send a
# separate booking.canceled event. Cancellation, decline and no-show reconcile
# through booking.updated plus the authoritative booking status.
# DEFERRED: keep ALL webhook variables (this section plus the QStash section)
# UNSET while webhooks stay disabled. The webhook endpoints fail closed without
# them. Do not configure them for launch.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# QStash Preview webhook queue. Names only; never commit real values.
# DEFERRED with webhooks: leave unset until the QStash milestone.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_WORKER_URL=
# VERCEL_AUTOMATION_BYPASS_SECRET is supplied by Vercel's Protection Bypass
# for Automation runtime system variable. Do not create a duplicate project env var.

# Frontend feature flag. Enables the appointment-request booking workflow.
# Any value other than exactly "true" shows the neutral call/email fallback
# (Call / email Kai Lani directly; no third-party booking service).
# This flag only controls which frontend UI renders; the server independently
# fails closed on every booking-request, Square, and email operation.
# The flag name does not imply a Sandbox: the same flow is used in the sandbox
# Preview and eventually in Production.
#   Preview (while in Sandbox): VITE_ENABLE_BOOKING_REQUESTS=true
#   Production: VITE_ENABLE_BOOKING_REQUESTS=true  (only when Production vars configured)
VITE_ENABLE_BOOKING_REQUESTS=false

# Server-only Resend email settings. Never commit real API keys.
#
# Sandbox mode (all must hold):
#   EMAIL_ENABLED=true, EMAIL_MODE=sandbox,
#   BOOKING_APPROVAL_MODE=sandbox, SQUARE_ENVIRONMENT=sandbox,
#   EMAIL_SANDBOX_RECIPIENT set.
#   EVERY email recipient is replaced with EMAIL_SANDBOX_RECIPIENT; subjects get
#   a [SANDBOX] prefix; real client/Chelsea addresses never receive them.
#
# Production mode (all must hold; do not enable until deliberately configured):
#   EMAIL_ENABLED=true, EMAIL_MODE=production,
#   BOOKING_APPROVAL_MODE=production, SQUARE_ENVIRONMENT=production,
#   CHELSEA_NOTIFICATION_EMAIL set.
#   Client emails go ONLY to the validated client email on the approved request;
#   approval + provider emails go ONLY to CHELSEA_NOTIFICATION_EMAIL.
#   EMAIL_SANDBOX_RECIPIENT is never used in production; subjects carry no
#   [SANDBOX] prefix.
#
# A missing or mismatched variable fails closed before any send.
EMAIL_ENABLED=false
EMAIL_MODE=sandbox
RESEND_API_KEY=
EMAIL_FROM=Kai Lani Sandbox <onboarding@resend.dev>
EMAIL_SANDBOX_RECIPIENT=
# REQUIRED in Production mode for provider/approval delivery (Chelsea's inbox).
# Unused in Sandbox mode (sandbox forces EMAIL_SANDBOX_RECIPIENT).
CHELSEA_NOTIFICATION_EMAIL=
EMAIL_REPLY_TO=
# Authoritative base URL for emailed approval links (/approve?token=...). This
# is the only approval-URL source; there is no BOOKING_APPROVAL_BASE_URL.
PUBLIC_SITE_URL=

# OPTIONAL, UNVERIFIED — webhook only. Vercel pre-parses JSON request bodies,
# which breaks raw-body HMAC verification. Setting NODEJS_HELPERS=0 (Vercel)
# makes the raw stream available, but affects ALL Node functions and must be
# validated with a signed Square Sandbox webhook before being relied on.
# Production must separately verify the exact notification URL, signature key,
# Square Dashboard subscription, retry behavior, and Square-to-Google calendar
# sync configuration. KEEP UNSET while webhooks are deferred.
# NODEJS_HELPERS=0

# Booking-request approval workflow (server-only).
# Enabled ONLY when all of the following hold exactly:
#   BOOKING_APPROVAL_ENABLED=true
#   BOOKING_APPROVAL_MODE is "sandbox" or "production" and EQUALS SQUARE_ENVIRONMENT
#   SQUARE_ENVIRONMENT is "sandbox" or "production"
# Every request/lookup/approve/decline/unsubscribe endpoint fails closed
# otherwise. Production is never defaulted to.
DATABASE_URL=
BOOKING_APPROVAL_ENABLED=false
BOOKING_APPROVAL_MODE=sandbox
# Approval-token lifetime in minutes (default 120). A pending request whose
# token expires is swept to `expired` and releases its website hold.
BOOKING_APPROVAL_TOKEN_TTL_MINUTES=120