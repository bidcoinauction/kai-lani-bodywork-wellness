{
  "name": "kai-lani-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node scripts/local-api-server.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test \"tests/*.test.js\"",
    "square:catalog:preview": "node scripts/setup-square-sandbox-services.mjs",
    "square:catalog:apply": "cross-env SQUARE_APPLY_CATALOG=true node scripts/setup-square-sandbox-services.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "square": "^44.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
